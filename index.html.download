<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kalshi Edge — Trading Console</title>
<style>
:root{--bg:#090d12;--panel:#121a24;--line:#263443;--txt:#edf4fb;--muted:#94a5b8;--green:#4de0a8;--red:#ff7584;--blue:#8abfff;--gold:#f5ce73}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% 0,#15273b 0,transparent 42%),var(--bg);font:14px/1.45 system-ui,-apple-system,Segoe UI,sans-serif;color:var(--txt)}.wrap{max-width:1200px;margin:auto;padding:24px 16px 48px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px}.brand{display:flex;align-items:center;gap:12px}.logo{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:linear-gradient(135deg,var(--green),var(--blue));color:#05120d;font-size:23px;font-weight:900}.brand h1{font-size:19px;margin:0}.brand p{margin:2px 0 0;color:var(--muted);font-size:12px}.badge{font-size:11px;border:1px solid #2b604b;color:var(--green);background:#10251e;padding:7px 10px;border-radius:99px;white-space:nowrap}.alert{border:1px solid #6c5427;background:#211b10;color:#f4d99c;border-radius:12px;padding:12px 14px;font-size:12px;margin-bottom:14px}.alert b{color:#ffe7a7}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.panel{background:linear-gradient(160deg,#141d28,#10161f);border:1px solid var(--line);border-radius:16px;padding:17px;min-width:0}.panel h2{font-size:15px;margin:0 0 13px}.muted{color:var(--muted);font-size:12px}.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.field{margin:10px 0}.field label{display:block;font-size:11px;color:var(--muted);margin-bottom:5px}.field input,.field select{width:100%;border:1px solid var(--line);background:#0a1017;color:var(--txt);border-radius:9px;padding:10px;outline:none}.field input:focus,.field select:focus{border-color:var(--blue)}button{background:#1b2938;color:var(--txt);border:1px solid #34485d;border-radius:9px;padding:10px 13px;font-weight:700;cursor:pointer}button:hover{border-color:var(--blue)}button.primary{background:var(--green);color:#06150f;border-color:var(--green)}button.warn{color:var(--gold)}button:disabled{opacity:.45;cursor:not-allowed}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:12px}.stat{border:1px solid var(--line);background:#111821;border-radius:13px;padding:13px}.stat span{display:block;color:var(--muted);font-size:11px}.stat strong{display:block;font-size:23px;margin-top:6px;overflow-wrap:anywhere}.wide{margin-top:12px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;border-bottom:1px solid #25303d;padding:10px 8px;white-space:nowrap}th{color:var(--muted);font-weight:550}tr:last-child td{border:0}.empty{padding:20px;text-align:center;color:var(--muted);font-size:12px}.msg{font-size:12px;margin-top:10px;white-space:pre-wrap;overflow-wrap:anywhere}.good{color:var(--green)}.bad{color:var(--red)}.small{font-size:11px;color:var(--muted);line-height:1.55}.check{display:flex;gap:9px;align-items:flex-start;font-size:12px;color:var(--gold);margin:12px 0}.check input{margin-top:3px}.foot{text-align:center;color:var(--muted);font-size:11px;margin-top:18px;line-height:1.6}
@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}.grid .panel:last-child{grid-column:1/-1}}@media(max-width:620px){.wrap{padding:16px 10px}.top{align-items:flex-start}.grid{grid-template-columns:1fr}.grid .panel:last-child{grid-column:auto}.stats{grid-template-columns:1fr 1fr 1fr}.stat strong{font-size:18px}.brand h1{font-size:16px}.badge{font-size:10px}.panel{padding:13px}}
</style></head>
<body><div class="wrap">
<header class="top"><div class="brand"><div class="logo">K</div><div><h1>Kalshi Edge</h1><p>Account connection · market scanner · controlled execution</p></div></div><div class="badge" id="modeBadge">LOADING MODE</div></header>
<div class="alert"><b>Security:</b> Never enter your Kalshi password here. This app uses an API key and private key stored on the server—not in your browser. Demo mode is the default. Live orders are limited to 10 contracts per order and require explicit confirmation.</div>
<div class="stats"><div class="stat"><span>Account balance</span><strong id="balance">—</strong></div><div class="stat"><span>Open positions</span><strong id="positionsN">—</strong></div><div class="stat"><span>Resting orders</span><strong id="ordersN">—</strong></div></div>
<div class="grid">
<section class="panel"><h2>1. Connect your account</h2><p class="muted">Configure your API key ID and private key in the server environment, then test the connection here.</p><button class="primary" id="connect">Connect / test credentials</button><div class="msg" id="connectMsg">Not connected.</div><p class="small">API credentials are never requested in this page. Keep the private key outside source control and browser storage.</p></section>
<section class="panel"><h2>2. Scan open markets</h2><div class="field"><label>Search markets</label><input id="search" placeholder="Search title or ticker"></div><button id="scan">Load live market data</button><div class="msg" id="scanMsg">Market data is public. Click scan to load open markets.</div></section>
<section class="panel"><h2>3. Submit a limit order</h2><div class="field"><label>Market ticker</label><input id="ticker" placeholder="Select a market from the list below"></div><div class="two"><div class="field"><label>Side</label><select id="side"><option value="yes">YES</option><option value="no">NO</option></select></div><div class="field"><label>Limit price (cents)</label><input id="price" type="number" min="1" max="99" value="10"></div></div><div class="field"><label>Contracts (1–10 per order)</label><input id="count" type="number" min="1" max="10" value="1"></div><label class="check"><input type="checkbox" id="confirmLive"><span>I understand this submits a real-money order if the server is configured for LIVE mode and live trading is enabled.</span></label><button class="primary" id="submitOrder">Submit limit order</button><div class="msg" id="orderMsg"></div><p class="small">No market orders. The server enforces mode and size limits. Check the market rules and price before submitting.</p></section>
</div>
<section class="panel wide"><h2>Open markets</h2><div class="table-wrap"><table><thead><tr><th>Market</th><th>Ticker</th><th>YES bid</th><th>NO bid</th><th>Volume</th><th>Action</th></tr></thead><tbody id="marketsBody"></tbody></table></div><div class="empty" id="marketsEmpty">No markets loaded.</div></section>
<section class="panel wide"><div class="row" style="justify-content:space-between"><h2 style="margin:0">Portfolio snapshot</h2><button id="refreshPortfolio">Refresh account</button></div><div id="portfolioMsg" class="msg muted">Connect to load your balance, positions, and orders.</div><div class="table-wrap"><table><thead><tr><th>Position / order</th><th>Details</th></tr></thead><tbody id="portfolioBody"></tbody></table></div></section>
<div class="foot">Use demo mode first. This is a starter trading console, not financial advice and not a guarantee of profits. Automated AI strategy generation is not enabled in this version. A live connection can lose money quickly; monitor orders and use strict limits.</div>
</div>
<script>
let currentMode='demo', markets=[];
const $=id=>document.getElementById(id);
const moneyCents=v=>v==null?'—':(Number(v)/100).toLocaleString(undefined,{style:'currency',currency:'USD'});
async function call(url,opts={}){const r=await fetch(url,{headers:{'Content-Type':'application/json'},...opts});const d=await r.json().catch(()=>({error:'Invalid server response'}));if(!r.ok)throw new Error(d.error||`HTTP ${r.status}`);return d;}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function init(){try{const s=await call('/api/status');currentMode=s.mode;$('modeBadge').textContent=currentMode==='live'?'LIVE MODE':'DEMO MODE';$('modeBadge').style.color=currentMode==='live'?'#ff7584':'#4de0a8';$('modeBadge').style.borderColor=currentMode==='live'?'#74333c':'#2b604b';if(currentMode==='live')$('modeBadge').textContent+=' · REAL MONEY';if(!s.credentials_configured)$('connectMsg').textContent='Server credentials not configured yet. See README setup steps.';}catch(e){$('connectMsg').textContent='Server unavailable: '+e.message;}}
$('connect').onclick=async()=>{ $('connectMsg').textContent='Testing connection…';try{const d=await call('/api/connect',{method:'POST',body:'{}'});$('connectMsg').innerHTML='<span class="good">Connected to '+esc(d.mode)+' API.</span>';await refreshPortfolio();}catch(e){$('connectMsg').innerHTML='<span class="bad">'+esc(e.message)+'</span>';}};
$('scan').onclick=async()=>{ $('scanMsg').textContent='Loading markets…';try{const d=await call('/api/markets');markets=d.markets||[];renderMarkets();$('scanMsg').textContent=`Loaded ${markets.length} open markets from ${currentMode} environment.`;}catch(e){$('scanMsg').textContent='Could not load markets: '+e.message;}};
function renderMarkets(){const q=$('search').value.toLowerCase();const list=markets.filter(m=>(String(m.title||'')+' '+String(m.ticker||'')).toLowerCase().includes(q)).slice(0,100);const b=$('marketsBody');b.innerHTML='';$('marketsEmpty').style.display=list.length?'none':'block';list.forEach(m=>{const tr=document.createElement('tr');tr.innerHTML=`<td>${esc(m.title||m.subtitle||'Untitled')}</td><td>${esc(m.ticker)}</td><td>${moneyCents(m.yes_bid)}</td><td>${moneyCents(m.no_bid)}</td><td>${esc(m.volume??'—')}</td><td><button data-ticker="${esc(m.ticker)}">Use</button></td>`;b.appendChild(tr);});b.querySelectorAll('button').forEach(btn=>btn.onclick=()=>{$('ticker').value=btn.dataset.ticker;window.scrollTo({top:0,behavior:'smooth'});});}
$('search').oninput=renderMarkets;
$('submitOrder').onclick=async()=>{const ticker=$('ticker').value.trim(),side=$('side').value,price=Number($('price').value),count=Number($('count').value);if(!ticker||!Number.isInteger(price)||price<1||price>99||!Number.isInteger(count)||count<1||count>10){$('orderMsg').textContent='Check ticker, price (1–99 cents), and count (1–10).';return;}if(currentMode==='live'&&!$('confirmLive').checked){$('orderMsg').textContent='Check the live-order confirmation box first.';return;}const est=(price*count/100).toLocaleString(undefined,{style:'currency',currency:'USD'});if(!confirm(`Submit ${count} ${side.toUpperCase()} limit contract(s) on ${ticker} at ${price}¢? Approximate contract cost before fees: ${est}. Mode: ${currentMode.toUpperCase()}.`))return;$('orderMsg').textContent='Submitting…';try{const d=await call('/api/order',{method:'POST',body:JSON.stringify({ticker,side,price,count,confirm_live:$('confirmLive').checked})});$('orderMsg').innerHTML='<span class="good">Order submitted to '+esc(d.mode)+' environment.</span>\\n'+esc(JSON.stringify(d.result,null,2));await refreshPortfolio();}catch(e){$('orderMsg').innerHTML='<span class="bad">'+esc(e.message)+'</span>';}};
async function refreshPortfolio(){ $('portfolioMsg').textContent='Loading account…';try{const d=await call('/api/portfolio');const b=d.balance?.balance??d.balance?.available_balance??d.balance?.portfolio_value;$('balance').textContent=b==null?'Connected':moneyCents(b);const ps=d.positions?.market_positions||d.positions?.positions||[];const os=d.orders?.orders||[];$('positionsN').textContent=ps.length;$('ordersN').textContent=os.length;const rows=[];ps.forEach(p=>rows.push([p.ticker||p.market_ticker,`Position: ${p.position??p.total_position??'—'} · market ${p.market_exposure??'—'}`]));os.forEach(o=>rows.push([o.ticker||o.market_ticker,`Order ${o.order_id||''} · ${o.side||''} ${o.action||''} · ${o.status||''} · count ${o.remaining_count??o.count??'—'}`]));$('portfolioBody').innerHTML=rows.map(r=>`<tr><td>${esc(r[0])}</td><td>${esc(r[1])}</td></tr>`).join('');$('portfolioMsg').textContent=`Account loaded from ${d.mode} environment.`;}catch(e){$('portfolioMsg').textContent='Could not load account: '+e.message;}}
$('refreshPortfolio').onclick=refreshPortfolio;init();
</script></body></html>